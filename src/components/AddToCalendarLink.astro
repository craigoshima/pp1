---
import icon from "../assets/icons/calendar-icon-23.svg"
const dateParam = Astro.params.date
const dateParts = dateParam?.split("-")
let day = ""
if (dateParts?.length === 3) {
    day = dateParts[2]
}
let icsUrl
const iconUrl = `../assets/icons/calendar-icon-${day}.svg`
console.log(Astro.params)
console.log("iconURL = ", iconUrl)
---

<a href="{href}" class="inline-flex items-center gap-2">
    <img src="icons/calendar-32.svg" width="16" height="16" />
    <span>Add to Calendar</span>
</a>
